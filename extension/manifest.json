{
  "manifest_version": 3,
  "name": "NovelEpub",
  "version": "0.1.0",
  "description": "Download web novels and pack them into a properly structured EPUB. Supports roliascan.com (more sites can be added as plugins).",
  "action": {
    "default_title": "NovelEpub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://roliascan.com/*"]
}